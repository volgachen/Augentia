# ── OpenAI-compatible endpoint ───────────────────────────────────────────────
# Used by OpenAIToolUseAdapter (TOOL_USE agents) and the web_fetch tool as a
# fallback when the AgentTemplate doesn't set its own base_url/api_key/model.
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5.5"

# Model used by the web_fetch tool to summarize fetched pages.
# Falls back to OPENAI_MODEL, then "gpt-4o-mini".
# WEB_FETCH_MODEL="gpt-4o-mini"

# ── Persistence ──────────────────────────────────────────────────────────────
# DB_TYPE selects the backend: "sqlite" (recommended local default), "mysql", or
# "mock" (in-memory, no persistence).
DB_TYPE="sqlite"
SQLITE_PATH=".local/augentia.db"

# MySQL is still supported for shared or production-like deployments.
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="augentia"

# ── Browser Usage ────────────────────────────────────────────────────────────
# If you wish to control the browser, please specify the node path
NODE_BIN="PATH_TO_NODE_EXE"

# ── Cross-session orchestration ──────────────────────────────────────────────
# Gateway URL the subagent / session_send / list_subagents tools call back into.
# GATEWAY_URL="http://localhost:12598"
# Root dir for fallback scratch worktrees when the parent isn't a git repo.
# Defaults to backend/tmp/sessions.
# AUGENTIA_WORKTREE_ROOT=

# ── Single-user authentication ───────────────────────────────────────────────
# Disabled by default for local development. When enabled, all REST APIs and
# WebSockets require the signed HttpOnly login cookie; backend tools use the
# internal token for loopback calls.
AUGENTIA_AUTH_ENABLED=false
# Generate with: python -m app.auth_cli
# AUGENTIA_AUTH_PASSWORD_HASH="scrypt$..."
# Generate each secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUGENTIA_SESSION_SECRET=
# AUGENTIA_INTERNAL_TOKEN=
AUGENTIA_SESSION_TTL_SECONDS=43200
AUGENTIA_COOKIE_SECURE=false
AUGENTIA_ALLOWED_ORIGINS="http://127.0.0.1:12599,http://localhost:12599"

# ── Logging ──────────────────────────────────────────────────────────────────
# AUGENTIA_DEBUG=1 enables DEBUG-level logs from all augentia.* loggers,
# including subprocess argv, NDJSON lines, tool-call args, and stderr.
# AUGENTIA_LOG_LEVEL overrides the level explicitly (DEBUG/INFO/WARNING/ERROR).
# AUGENTIA_DEBUG=0
# AUGENTIA_LOG_LEVEL=INFO
